# Copie para .env e preencha. Veja docs/SETUP.md.

# Endereço onde o app roda (usado no redirecionamento do Google)
APP_URL=http://localhost:3000

# Banco PostgreSQL (o docker-compose.yml sobe este)
DATABASE_URL=postgresql://caixa:caixa@localhost:5432/caixa

# Credenciais OAuth do Google Cloud (tipo "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domínio do Google Workspace da empresa. Só emails dele podem entrar.
DOMINIO_PERMITIDO=suaempresa.com.br

# Gere cada um com: openssl rand -base64 32
SESSION_SECRET=
TOKEN_KEY=

# Opcionais
# Sincroniza o Gmail a cada N segundos enquanto o app roda (0 desliga).
SINCRONIZAR_A_CADA_SEGUNDOS=60
# Na primeira conexão de uma caixa, traz os emails dos últimos N dias.
SINCRONIZAR_DIAS=30
# Fuso para exibir datas.
FUSO=America/Sao_Paulo
# Se definido, permite um agendador externo chamar POST /api/sincronizar
# com o cabeçalho "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
